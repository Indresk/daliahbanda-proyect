{
  "routes": [
    {
      "src": "/sitemap.xml",
      "dest": "/client/sitemap.xml"
    },
    {
      "src": "/robots.txt",
      "dest": "/client/robots.txt"
    },
    {
      "src": "/manifest.json",
      "dest": "/client/manifest.json"
    },
    {
      "src": "/browserconfig.xml",
      "dest": "/client/browserconfig.xml"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/client/assets/$1"
    },
    {
      "src": "/(.*\\.(ico|png|jpg|jpeg|svg|webp|css|js|woff2?))",
      "dest": "/client/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/ssr.js"
    }
  ]
}